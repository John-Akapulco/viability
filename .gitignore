__pycache__/
*.pyc
.venv/
venv/

# VASP pseudopotentials are license-restricted (cannot be redistributed) and
# raw wavefunction/charge-density binaries are large + regenerable -- keep
# the run *inputs*/*settings* and LOBSTER text output, drop the rest.
mp_dataset/structures/*/POTCAR
mp_dataset/structures/*/CHG
mp_dataset/structures/*/CHGCAR
mp_dataset/structures/*/CHGCAR.gz
mp_dataset/structures/*/vasp.log
mp_dataset/structures/*/*.log
lobsterout

# LOBSTER dense per-grid outputs (COHP/COOP/COBI *CAR* files can be 10s of MB
# each): keep only the small ICOHPLIST/ICOBILIST summaries percolation_path.py
# actually consumes, plus the run's own lobsterout/lobsterin for provenance.
mp_dataset/structures/*/COHPCAR.lobster
mp_dataset/structures/*/COBICAR.lobster
mp_dataset/structures/*/COOPCAR.lobster
mp_dataset/structures/*/DOSCAR.lobster
mp_dataset/structures/*/projectionData.lobster
mp_dataset/structures/*/bandOverlaps.lobster
mp_dataset/structures/*/WAVECAR*

